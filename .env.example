# ==============================================================================
# Twitch Drops Miner - Docker & Environment Configuration
# ==============================================================================
# Copy this file to .env and adjust the values according to your needs.
# Variables left empty or commented out will fall back to files/settings.json or default values.

# ------------------------------------------------------------------------------
# 1. DISCORD WEBHOOK NOTIFICATIONS (One-Way)
# ------------------------------------------------------------------------------
# Discord Webhook URL for periodic summaries and drop alerts.
# Example: https://discord.com/api/webhooks/1234567890/abcdef...
DISCORD_WEBHOOK_URL=

# How often (in minutes) periodic summary notifications are sent (default: 60).
# Leave empty to use the value from files/settings.json.
DISCORD_SUMMARY_INTERVAL=60

# ------------------------------------------------------------------------------
# 2. INTERACTIVE DISCORD BOT (Two-Way Slash Commands)
# ------------------------------------------------------------------------------
# Discord Bot Token created from Discord Developer Portal.
# Enables interactive Slash commands (/status, /games, /drops, /priority, /settings, /2fa).
DISCORD_BOT_TOKEN=

# Your personal Discord User ID (Right-click your profile in Discord -> Copy User ID).
# When set, control actions (/priority, /2fa, stream switch) are restricted to you.
# If left empty, control is permitted to Discord Guild Administrators.
DISCORD_OWNER_ID=

# ------------------------------------------------------------------------------
# 3. LIGHTWEIGHT WEB DASHBOARD & REST API (:8080)
# ------------------------------------------------------------------------------
# Enable or disable the built-in dark mode Web UI & REST API (default: true).
WEB_DASHBOARD=true

# Port on the host to expose the Web Dashboard (default: 8080).
WEB_PORT=8080

# Optional password protection for the Web Dashboard and REST API.
# Leave empty for unauthenticated local network access.
WEB_PASSWORD=

# ------------------------------------------------------------------------------
# 4. ZERO-TOUCH PLAYWRIGHT LOGIN & COOKIE REFRESHER
# ------------------------------------------------------------------------------
# Automatically launch headless Chromium to refresh Twitch session cookies (default: true).
AUTO_COOKIE_REFRESH=true

# Optional Twitch credentials for automatic headless login via Playwright.
# (If 2FA is enabled, solve it directly in the Web Dashboard or via Discord /2fa).
TWITCH_USERNAME=
TWITCH_PASSWORD=

# ------------------------------------------------------------------------------
# 5. MINER BEHAVIOR & PERFORMANCE TUNING
# ------------------------------------------------------------------------------
# Priority Mode for selecting streams:
#   BALANCED       - (Recommended) Smart ranking: priority list + scarce drops + endings
#   PRIORITY_ONLY  - Strictly mine games specified in the priority list
#   ENDING_SOONEST - Mine campaigns ending earliest
#   LOW_AVBL_FIRST - Mine campaigns with lowest availability time
PRIORITY_MODE=BALANCED

# Background maintenance and inventory refresh interval in minutes (default: 20, min: 5).
MAINTENANCE_INTERVAL_MINUTES=20

# Logging verbosity: DEBUG, INFO, WARNING, ERROR (default: INFO).
LOGGING_LEVEL=INFO

# Container Timezone (e.g. UTC, Europe/Budapest, America/New_York)
TZ=Europe/Budapest
